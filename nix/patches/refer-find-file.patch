+local function go_to_parent(_, builtin)
+    local picker = builtin.picker
+    local input = vim.api.nvim_get_current_line()
+    local without_trailing_slashes = input:gsub("/+$", "")
+    local parent
+    if without_trailing_slashes == "" then
+        parent = "/"
+    else
+        parent = path_parent(without_trailing_slashes)
+    end
+
+    if not parent or parent == "" then
+        parent = "/"
+    elseif parent:sub(-1) ~= "/" then
+        parent = parent .. "/"
+    end
+
+    picker.ui:update_input { parent }
+    vim.api.nvim_win_set_cursor(picker.ui.input_win, { 1, #parent })
+    picker:refresh()
+end
+
+local function complete_item(_, builtin)
+    local picker = builtin.picker
+    local item = picker.current_matches[picker.selected_index]
+    if not item or not item.data or not item.data.filename then
+        builtin.actions.complete_selection()
+        return
+    end
+
+    local input = vim.api.nvim_get_current_line()
+    local completed = util.complete_line(input, item.data.filename)
+    if item.data.is_dir and completed:sub(-1) ~= "/" then
+        completed = completed .. "/"
+    end
+
+    picker.ui:update_input { completed }
+    vim.api.nvim_win_set_cursor(picker.ui.input_win, { 1, #completed })
+    picker:refresh()
+end
